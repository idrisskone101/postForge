{
  "name": "postforge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "next dev --turbopack",
    "build:dashboard-css": "node scripts/build-dashboard-css.mjs",
    "build:first-paint-css": "node scripts/build-first-paint-css.mjs",
    "predev": "node scripts/build-dashboard-css.mjs && node scripts/build-first-paint-css.mjs",
    "prebuild": "node scripts/build-dashboard-css.mjs && node scripts/build-first-paint-css.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/run-tests.ts",
    "test:home": "tsx scripts/run-tests.ts tests/home",
    "test:jobs": "tsx scripts/run-tests.ts tests/jobs",
    "test:inspiration": "tsx scripts/run-tests.ts tests/inspiration",
    "test:clone": "tsx scripts/run-tests.ts tests/clone",
    "test:slideshow": "tsx scripts/run-tests.ts tests/slideshow",
    "test:gallery": "tsx scripts/run-tests.ts tests/gallery",
    "test:automations": "tsx scripts/run-tests.ts tests/automations",
    "test:performance": "tsx scripts/run-tests.ts tests/performance",
    "test:spend": "tsx scripts/run-tests.ts tests/spend",
    "test:generate": "tsx scripts/run-tests.ts tests/generate",
    "test:characters": "tsx scripts/run-tests.ts tests/characters",
    "test:settings": "tsx scripts/run-tests.ts tests/settings",
    "test:integrations": "tsx scripts/run-tests.ts tests/integrations",
    "test:workspace": "tsx scripts/run-tests.ts tests/workspace",
    "test:lib": "tsx scripts/run-tests.ts tests/lib",
    "check:module-size": "tsx scripts/check-module-size.ts",
    "check:kode-taste": "tsx scripts/check-kode-taste.ts",
    "kode:setup": "bash scripts/kode-setup.sh",
    "kode:check": "bash scripts/kode-check.sh",
    "kode:smoke": "bash scripts/kode-smoke.sh",
    "check:first-paint-tokens": "tsx scripts/check-first-paint-tokens.ts",
    "test:visual-regression": "tsx scripts/visual-regression-sweep.ts",
    "kode:lighthouse": "bash scripts/kode-lighthouse.sh",
    "prune:playwright": "bash scripts/prune-playwright-artifacts.sh",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset",
    "storage:migrate:railway": "tsx scripts/migrate-storage-to-railway.ts",
    "storage:migrate:metadata": "tsx scripts/migrate-metadata-to-railway.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1106.0",
    "@base-ui/react": "^1.2.0",
    "@fal-ai/client": "^1.9.4",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "pg": "^8.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^2.15.4",
    "satori": "^0.29.0",
    "shadcn": "^4.0.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
