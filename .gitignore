# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.mp4
*.jpeg
*.jpg
*.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local

# PostForge generated outputs
data/outputs/images/*
data/outputs/videos/*
!data/outputs/images/.gitkeep
!data/outputs/videos/.gitkeep

# TikTok source videos
data/outputs/tiktok-sources/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Playwright
.playwright-cli/
.playwright-mcp/
playwright-report/
test-results/
blob-report/
