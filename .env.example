# Database
DATABASE_URL="postgresql://postforge:postforge@localhost:5432/postforge"

# fal.ai API Key (get from https://fal.ai/dashboard/keys)
FAL_KEY=""

# Gemini API Key (AI slideshow story/caption generation)
GEMINI_API_KEY=""
# Optional override; defaults to the current Flash model used by PostForge.
GEMINI_SLIDESHOW_MODEL="gemini-3.6-flash"
# Optional comma-separated HTTPS host allowlist for remotely sourced slideshow images.
SLIDESHOW_REMOTE_IMAGE_HOSTS=""
# Secret used by durable slideshow automation and image-recovery cron work.
# Vercel also supports CRON_SECRET.
SLIDESHOW_AUTOMATION_CRON_SECRET=""
# Set to 1 only when an external cron/worker is the sole scheduler.
SLIDESHOW_AUTOMATION_WORKER_DISABLED="0"
# Optional FFmpeg binary override for MP4 slideshow exports.
FFMPEG_PATH="ffmpeg"

# API Authentication (generate a random string, e.g.: openssl rand -hex 32)
POSTFORGE_API_KEY=""

# Virlo API Key (for UGC Inspiration creator sync)
VIRLO_API_KEY=""

# Server
PORT=3000
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Storage
STORAGE_DRIVER="database"
STORAGE_LOCAL_PATH="/Users/idrisskone/Desktop/PostForge/data/outputs"
