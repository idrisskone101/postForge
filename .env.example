# Database
DATABASE_URL="postgresql://postforge:postforge@localhost:5432/postforge"

# fal.ai API Key (get from https://fal.ai/dashboard/keys)
FAL_KEY=""

# Gemini API Key (AI slideshow story/caption generation)
GEMINI_API_KEY=""
# Optional override; defaults to the current Flash model used by PostForge.
GEMINI_SLIDESHOW_MODEL="gemini-3.6-flash"
# Optional comma-separated HTTPS host allowlist for remotely sourced slideshow images.
SLIDESHOW_REMOTE_IMAGE_HOSTS=""
# Secret used by durable slideshow automation and image-recovery cron work.
# Vercel also supports CRON_SECRET.
SLIDESHOW_AUTOMATION_CRON_SECRET=""
# Set to 1 only when an external cron/worker is the sole scheduler.
SLIDESHOW_AUTOMATION_WORKER_DISABLED="0"
# Optional FFmpeg binary override for MP4 slideshow exports.
FFMPEG_PATH="ffmpeg"

# API Authentication (generate a random string, e.g.: openssl rand -hex 32)
POSTFORGE_API_KEY=""

# Required before YouTube is advertised ready. Vercel sends this as
# Authorization: Bearer <secret> to the daily provider-data retention route.
# Use a random value of at least 16 characters.
CRON_SECRET=""

# Virlo API Key (for UGC Inspiration creator sync)
VIRLO_API_KEY=""

# Server
PORT=3000
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# TikTok and Instagram publishing require a public HTTPS origin. TikTok also
# requires this domain or URL prefix to be verified in its developer portal.
POSTFORGE_PUBLIC_URL="http://localhost:3000"

# Social integrations (server only)
# Generate a 32-byte key with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=""

# Public legal disclosures required before YouTube OAuth is advertised ready.
# PostForge validates public HTTPS URLs only; it does not create or attest the
# disclosures, guarantee policy compliance, or claim Google/YouTube approval.
POSTFORGE_PRIVACY_POLICY_URL=""
POSTFORGE_TERMS_URL=""
POSTFORGE_DATA_DELETION_URL=""

# TikTok Login Kit / Display API + approved video.publish scope
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# Operator attestation only. Set true after TikTok confirms this app's Direct
# Post review in the developer portal. Setting this flag does not obtain or
# prove approval; internal or team-only upload tools may not qualify.
TIKTOK_DIRECT_POST_APPROVAL_ACKNOWLEDGED="false"

# Instagram API with Instagram Login + instagram_business_content_publish;
# the public media URL must be reachable by Meta's crawler.
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_GRAPH_API_VERSION="v23.0"
# Required for Instagram publishing readiness and final pre-submit validation.
# Install ffprobe in the deployment image and set an absolute executable path.
# OAuth, profile, and metrics can remain connected without it, but PostForge
# will fail closed and will not advertise or attempt Reel publishing.
FFPROBE_PATH="/usr/bin/ffprobe"

# Google OAuth / YouTube Data API + youtube.upload. Unverified API projects
# can have public or unlisted uploads forced to private by YouTube.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Storage
STORAGE_DRIVER="database"
STORAGE_LOCAL_PATH="/Users/idrisskone/Desktop/PostForge/data/outputs"
